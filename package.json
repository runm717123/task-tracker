{
  "name": "ndev-task-tracker",
  "description": "A task tracker extension, designed for quick task tracking",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env WXT_ENV=dev wxt build",
    "build:prod": "cross-env WXT_ENV=prod wxt --mode production build && cross-env WXT_ENV=prod wxt --mode production zip",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare",
    "dev:watch": "nodemon --exec \"pnpm run dev\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write . --ignore-path .gitignore '!public' '!public-dev'"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test/**",
      "**/docs/**"
    ],
    "watch": [
      "src",
      "wxt.config.ts"
    ],
    "ext": "ts,js,svelte,json,css",
    "delay": 1000
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.0",
    "@testing-library/svelte": "5.4.2",
    "@tsconfig/svelte": "5.0.4",
    "@types/chrome": "0.0.329",
    "@vitest/ui": "3.2.4",
    "@wxt-dev/module-svelte": "2.0.3",
    "cross-env": "7.0.3",
    "happy-dom": "21.0.4",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.39.11",
    "svelte-check": "4.1.6",
    "tslib": "2.8.1",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "wxt": "0.20.11"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-document": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-paragraph": "3.32.2",
    "@tiptap/extension-text": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@webtui/css": "0.1.10",
    "dayjs": "1.11.13"
  }
}
